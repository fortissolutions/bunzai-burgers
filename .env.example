# Copy to .env and fill in. Never commit .env.

# ---------- App ----------
PORT=8080
# Admin login for /admin. Use a strong password in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Keeps admins signed in across restarts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Folder for the SQLite database (Docker always uses /app/data on a volume).
DATA_DIR=./data
# development locally; Docker sets production automatically.
NODE_ENV=development
# Set to false only if the server is NOT behind a proxy/load balancer.
TRUST_PROXY=true
# Admin cookie is HTTPS-only in production. Set false only while testing on plain http.
# COOKIE_SECURE=false

# ---------- Docker / server only ----------
# Domain for automatic HTTPS via Caddy (DNS must point at the server).
# Leave empty to serve plain http on port 80.
# DOMAIN=spin.bunzaiburgers.com
# Image to run, e.g. from Amazon ECR:
# APP_IMAGE=123456789012.dkr.ecr.me-central-1.amazonaws.com/bunzai-burgers:v1
